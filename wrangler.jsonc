{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jet2-virtual-airline",
  "compatibility_date": "2026-09-10",
  "main": "src/worker.js",

  "vars": {},

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jet2-ptfs-db",
      "database_id": "7edad159-71d2-44d1-9ac2-c561208e9cbb"
    }
  ]
}
